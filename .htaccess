# 3AmigosBiscuits - Hostinger (Apache/LiteSpeed) settings
DirectoryIndex index.html index.php
Options -Indexes

# Force HTTPS (turn on SSL in hPanel first)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

# Block direct access to the settings file
<Files "config.php">
    Require all denied
</Files>

ErrorDocument 404 /index.html

# Cache CSS/JS/images for a week
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Hide repo files (CLAUDE.md, .gitignore, .git) from visitors
<FilesMatch "(\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
